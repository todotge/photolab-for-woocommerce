{
  "name": "photolab/photolab",
  "description": "WordPress + WooCommerce plugin for photo album management",
  "version": "0.0.5",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1",
    "phpstan/phpstan": "^2.2",
    "php-stubs/wordpress-stubs": "^7.0",
    "php-stubs/woocommerce-stubs": "^3.8",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs --standard=WordPress --warning-severity=0 --extensions=php includes/ templates/ photolab.php",
    "phpcbf": "phpcbf --standard=WordPress --extensions=php includes/ templates/ photolab.php",
    "phpstan": "phpstan analyse --memory-limit=2G",
    "phpstan:baseline": "phpstan analyse --generate-baseline"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
